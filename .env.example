# Copy to .env for local development. Never commit real keys.
# Every variable is optional: LureRadar works offline without any of them.

# Override the public site/feed base URL (default: see src/lureradar/config.py)
# LURERADAR_BASE_URL=https://abdelrahmanmostafa-eng.github.io/LureRadar/

# Google Safe Browsing v4 API key (external_reputation)
LURERADAR_SAFEBROWSING_KEY=
# abuse.ch URLhaus Auth-Key (https://auth.abuse.ch/)
LURERADAR_URLHAUS_KEY=
# urlscan.io API key (optional; search works without one at lower limits)
LURERADAR_URLSCAN_KEY=
# CertStream-compatible websocket for `lureradar watch`
# LURERADAR_CERTSTREAM_URL=wss://certstream.calidog.io/
# Feed signing key (base64 Ed25519 seed) - CI secret only, see docs/FEEDS.md
# LURERADAR_SIGNING_KEY=
# Pin "now" for reproducible runs (ISO 8601)
# LURERADAR_NOW=2026-11-21T12:00:00Z
