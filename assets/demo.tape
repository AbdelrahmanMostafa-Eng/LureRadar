# vhs tape for the README hero GIF: `vhs assets/demo.tape`
# (make demo falls back to scripts/render_demo.py when vhs is not installed)
Output assets/demo.gif
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set Width 1000
Set Height 640
Set Padding 18
Set Theme { "background": "#07090D", "foreground": "#E6EDF3", "cursor": "#3CFFB0", "black": "#0D1117", "red": "#FF4D5E", "green": "#3CFFB0", "yellow": "#FFB020", "blue": "#4CC2FF", "magenta": "#4CC2FF", "cyan": "#4CC2FF", "white": "#E6EDF3", "brightBlack": "#8B98A5", "brightRed": "#FF4D5E", "brightGreen": "#3CFFB0", "brightYellow": "#FFB020", "brightBlue": "#4CC2FF", "brightMagenta": "#4CC2FF", "brightCyan": "#4CC2FF", "brightWhite": "#FFFFFF" }
Set TypingSpeed 25ms
Hide
Type "export COLUMNS=92 && clear"
Enter
Show
Type 'uvx lureradar check "https://rockstar-gta6-pc-download[.]test/free-key"'
Sleep 400ms
Enter
Sleep 4.5s
