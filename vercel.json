{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "framework": "astro",
      "buildCommand": "bash scripts/vercel-build.sh",
      "routes": [
        {
          "handle": "error"
        },
        {
          "src": "/(.*)",
          "status": 404,
          "dest": "/404.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
