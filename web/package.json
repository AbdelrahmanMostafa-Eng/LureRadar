{
  "name": "lureradar-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "LureRadar static dashboard (Astro). Data is generated by scripts/build_site_data.py.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "node --experimental-strip-types --no-warnings scripts/parity.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "astro": "7.4.13",
    "marked": "18.2.1"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo-google-fonts/saira-condensed": "0.4.1",
    "axe-core": "4.14.1",
    "opentype.js": "2.0.0"
  }
}
