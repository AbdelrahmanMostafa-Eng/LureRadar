---
// The LureRadar mark: radar rings, sweep, and a blip resolved into a hook.
interface Props { size?: number; title?: string }
const { size = 30, title } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 8)}`;
---
<svg viewBox="0 0 64 64" width={size} height={size} role={title ? "img" : undefined} aria-hidden={title ? undefined : "true"} aria-label={title}>
  <defs>
    <linearGradient id={id} x1="32" y1="32" x2="54" y2="12" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--radar)" stop-opacity="0" />
      <stop offset="1" stop-color="var(--radar)" stop-opacity=".6" />
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="27" fill="none" stroke="var(--radar)" stroke-width="4" />
  <circle cx="32" cy="32" r="15.5" fill="none" stroke="var(--radar)" stroke-width="2.5" opacity=".45" />
  <path d="M32 32V5a27 27 0 0 1 23.4 13.5Z" fill={`url(#${id})`} />
  <path d="M32 32 55.4 18.5" stroke="var(--radar)" stroke-width="3" stroke-linecap="round" />
  <circle cx="32" cy="32" r="3.2" fill="var(--radar)" />
  <g fill="none" stroke="var(--amber)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M43 36.5V44a4.5 4.5 0 0 1-9 0v-3.2l2.8 2.6" />
    <circle cx="43" cy="33.6" r="1.9" stroke-width="2.4" />
  </g>
</svg>
