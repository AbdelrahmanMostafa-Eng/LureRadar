---
// LureRadar's plan-position indicator (PPI), drawn the way a marine / ATC
// radar face is drawn, with meaning in every mark:
//  - bearing = a stable hash of the domain (000-359°); range = the verdict
//    score: the closer to the centre, the more certain. Range rings sit on the
//    tier thresholds and carry their score like range numerals; the hatched
//    core is the CONFIRMED zone (hatching is how charts mark restricted water).
//  - echoes are short arc-shaped returns painted by the sweep that decay like
//    phosphor; tracks use ARPA symbols: dashed circle = acquiring (suspicious),
//    circle = tracked (likely), triangle = dangerous target (confirmed).
//  - the operator tools are the real ones: an electronic bearing line (EBL)
//    and a variable range marker (VRM) follow the pointer and snap to echoes,
//    and a selected track carries an ATC-style data tag on a leader line.
// The figure reads fully without JavaScript; prefers-reduced-motion freezes it.
import { all, polar, defang, href, safeJson, TIER_LABEL } from "../lib/site";

const PERIOD = 7;
const C = 220;
const R = 166;
const MIN = 0.12;
const SPAN = 0.8;
const range = (score: number) => MIN + ((100 - Math.min(100, Math.max(40, score))) / 60) * SPAN;
const pt = (deg: number, rr: number): [number, number] => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + Math.cos(a) * rr, C + Math.sin(a) * rr];
};
const contacts = all.indicators
  .filter((i) => i.status === "active")
  .map((i) => {
    const { angle } = polar(i.domain);
    const [x, y] = pt(angle, R * range(i.score));
    const kind = i.tier === "confirmed" || i.score >= 90 ? "confirmed" : i.tier === "likely" ? "likely" : "suspicious";
    return { x, y, angle, kind, score: i.score, label: defang(i.domain), tier: TIER_LABEL[i.tier] ?? i.tier, delay: -((360 - angle) / 360) * PERIOD };
  })
  .sort((a, b) => b.score - a.score)
  .map((c, i) => ({ ...c, id: i, track: `T${String(i + 1).padStart(2, "0")}` }));
const tracks = contacts.map((c) => ({ i: c.id, t: c.track, x: +c.x.toFixed(1), y: +c.y.toFixed(1), b: c.angle, s: c.score, k: c.kind, d: c.label, tier: c.tier }));
const rings = [90, 70, 40];
// Range-ring numerals, as on a real PPI: all on one bearing line, interrupting
// their ring, upright. The bearing is whichever leaves them clearest of tracks
// (the way a chart sets contour labels where the soundings leave room).
const angDiff = (a: number, b: number) => Math.abs(((a - b + 540) % 360) - 180);
const scaleBearing = (() => {
  let best = 315, bestCost = Infinity;
  for (let b = 0; b < 360; b += 3) {
    if ([0, 90, 180, 270].some((axis) => angDiff(b, axis) < 8)) continue; // keep off the cross
    let cost = angDiff(b, 315) / 2000; // all else equal, upper-left
    for (const score of rings) {
      const [lx, ly] = pt(b, R * range(score));
      for (const c of contacts) {
        const d = Math.hypot(c.x - lx, c.y - ly);
        if (d < 20) cost += 1 + (20 - d) / 20;
      }
    }
    if (cost < bestCost) { bestCost = cost; best = b; }
  }
  return best;
})();
const ticks = Array.from({ length: 180 }, (_, i) => i * 2);
const radarPage = href("radar/");
---
<figure class="radar" aria-labelledby="radar-cap" data-radar-page={radarPage}>
  <div class="scope" style={`--period:${PERIOD}s`}>
    <svg class="face" viewBox="0 0 440 440" aria-hidden="true">
      <defs>
        <pattern id="lr-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="5" class="hatch" />
        </pattern>
        <radialGradient id="lr-face" cx="220" cy="220" r={R} gradientUnits="userSpaceOnUse">
          <stop offset="0" class="face-0" />
          <stop offset="1" class="face-1" />
        </radialGradient>
      </defs>
      <circle cx={C} cy={C} r={R} fill="url(#lr-face)" />
      <circle cx={C} cy={C} r={(R * range(90)).toFixed(1)} fill="url(#lr-hatch)" />
      {rings.map((score) => <circle class="ring" cx={C} cy={C} r={(R * range(score)).toFixed(1)} />)}
      <path class="cross" d={`M${C - R} ${C}H${C + R}M${C} ${C - R}V${C + R}`} />
      {rings.map((score) => {
        const [x, y] = pt(scaleBearing, R * range(score));
        return <text class="ring-label" x={x.toFixed(1)} y={y.toFixed(1)}>{score}</text>;
      })}
      <circle class="edge" cx={C} cy={C} r={R} />
      <circle class="bezel" cx={C} cy={C} r={R + 13} />
      {ticks.map((d) => {
        const major = d % 30 === 0;
        const mid = d % 10 === 0;
        const [x1, y1] = pt(d, R + (major ? 1 : mid ? 4 : 7));
        const [x2, y2] = pt(d, R + 11);
        return <line class={major ? "tk tk-major" : mid ? "tk tk-mid" : "tk"} x1={x1.toFixed(2)} y1={y1.toFixed(2)} x2={x2.toFixed(2)} y2={y2.toFixed(2)} />;
      })}
      {ticks.filter((d) => d % 30 === 0).map((d) => {
        // Tangential like a compass ring, but flipped in the lower half so no
        // numeral ever reads upside down ("180", not "081").
        const flip = d > 90 && d < 270;
        return (
          <text class="deg" x={C} y={C - R - 23} dominant-baseline="central" transform={`rotate(${d} ${C} ${C})${flip ? ` rotate(180 ${C} ${C - R - 23})` : ""}`}>{String(d).padStart(3, "0")}</text>
        );
      })}
    </svg>
    <div class="sweep" aria-hidden="true"></div>
    <div class="echoes" aria-hidden="true">
      {contacts.map((c) => (
        <i class="echo" style={`left:${(c.x / 4.4).toFixed(2)}%;top:${(c.y / 4.4).toFixed(2)}%;--b:${c.angle}deg;--d:${c.delay.toFixed(2)}s`}></i>
      ))}
    </div>
    <svg class="over" viewBox="0 0 440 440" aria-hidden="true">
      {contacts.map((c) => (
        <g class={`trk trk-${c.kind}`} data-i={c.id} transform={`translate(${c.x.toFixed(1)} ${c.y.toFixed(1)})`}>
          {c.kind === "confirmed"
            ? <path class="sym" d="M0 -8.6L7.4 4.3H-7.4Z" pathLength="1" />
            : <circle class="sym" r="7" pathLength="1" />}
          <text class="tid" x="10" y="-8">{c.track}</text>
        </g>
      ))}
      <g class="ebl" data-ebl>
        <circle class="vrm" data-vrm cx={C} cy={C} r="0" />
        <line class="eline" data-eline x1={C} y1={C} x2={C} y2={C} />
        <circle class="emark" data-emark r="3.2" cx={C} cy={C} />
      </g>
      <g class="tag" data-tag>
        <polyline class="lead" data-lead points="0,0 0,0 0,0" pathLength="1" />
        <rect class="tag-bg" data-tag-bg x="0" y="0" width="92" height="30" />
        <text class="tag-1" data-tag-1 x="0" y="0"></text>
        <text class="tag-2" data-tag-2 x="0" y="0"></text>
      </g>
      <circle class="own" cx={C} cy={C} r="2.4" />
      <circle class="own-ring" cx={C} cy={C} r="7" />
    </svg>
  </div>
  <figcaption class="ops">
    <p id="radar-cap" class="visually-hidden">
      Radar of {contacts.length} active indicator{contacts.length === 1 ? "" : "s"}: distance from the centre is the score, so the closest contacts are the most certain lures. Use the track buttons below to step through them.
    </p>
    <div class="ops-read" aria-hidden="true">
      <div><span class="k">BRG</span><span class="v" data-v-brg>–––.–°</span></div>
      <div><span class="k">RNG · SCORE</span><span class="v" data-v-rng>–––</span></div>
      <div><span class="k">ZONE</span><span class="v" data-v-zone>—</span></div>
    </div>
    <p class="ops-track" aria-live="polite" data-track data-idle={contacts.length ? `${contacts.length} tracks on the scope. Select one.` : "Scope clear: no active contacts right now."}>
      {contacts.length ? `${contacts.length} tracks on the scope. Select one.` : "Scope clear: no active contacts right now."}
    </p>
    <div class="ops-ctl">
      <button type="button" class="ops-btn" data-step="-1" aria-label="Previous track" disabled={!contacts.length}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
      </button>
      <span class="ops-count" data-count>{`T–– / ${String(contacts.length).padStart(2, "0")}`}</span>
      <button type="button" class="ops-btn" data-step="1" aria-label="Next track" disabled={!contacts.length}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
      </button>

      <button type="button" class="ops-btn ops-wide" aria-pressed="false" aria-label="Pause sweep" data-sweep-toggle>
        <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg>
        <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9l7-4.5z" class="fill" /></svg>
        <span class="t" aria-hidden="true">Pause</span>
      </button>
    </div>
    <p class="ops-legend" aria-hidden="true">
      <span><svg viewBox="-8 -8 16 16"><path class="lg lg-c" d="M0 -6L5.2 3H-5.2Z" /></svg>Confirmed <b>≥90</b></span>
      <span><svg viewBox="-8 -8 16 16"><circle class="lg lg-l" r="5" /></svg>Likely <b>≥70</b></span>
      <span><svg viewBox="-8 -8 16 16"><circle class="lg lg-s" r="5" /></svg>Suspicious <b>≥40</b></span>
    </p>
  </figcaption>
  <script type="application/json" data-tracks set:html={safeJson(tracks)} />
</figure>
<style>
  .radar { margin: 0; display: grid; gap: 22px; justify-items: center; }
  .scope { position: relative; width: 100%; max-width: 520px; aspect-ratio: 1; touch-action: manipulation; }
  .scope > svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  /* Face: hairlines, not glow. */
  .face-0 { stop-color: var(--radar); stop-opacity: 0.06; }
  .face-1 { stop-color: var(--radar); stop-opacity: 0; }
  .hatch { stroke: var(--danger); stroke-opacity: 0.3; stroke-width: 0.9; }
  .ring { fill: none; stroke: var(--border-strong); stroke-width: 0.8; stroke-dasharray: 1.5 3.5; }
  .cross { stroke: var(--border-strong); stroke-width: 0.6; stroke-dasharray: 0.8 5; }
  .edge { fill: none; stroke: color-mix(in srgb, var(--radar) 45%, var(--border-strong)); stroke-width: 1; }
  .bezel { fill: none; stroke: var(--border); stroke-width: 1; }
  .tk { stroke: var(--border-strong); stroke-width: 0.7; }
  .tk-mid { stroke: var(--muted); stroke-opacity: 0.65; stroke-width: 0.9; }
  .tk-major { stroke: var(--text-2); stroke-width: 1.2; }
  .deg { font: 500 8.5px var(--font-mono); fill: var(--muted); text-anchor: middle; letter-spacing: 0.08em; }
  /* map-label halo: a background-coloured outline keeps labels legible over tracks */
  .ring-label { font: 500 7.4px var(--font-mono); fill: var(--muted); letter-spacing: 0.04em; text-anchor: middle; dominant-baseline: central; paint-order: stroke; stroke: var(--bg); stroke-width: 3.4px; stroke-linejoin: round; }

  /* Sweep: a thin arm with a short phosphor decay. */
  .sweep {
    position: absolute; inset: 12.27%; /* = scope radius 166 / 440 */ border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0deg 322deg, color-mix(in srgb, var(--radar) 3%, transparent) 332deg, color-mix(in srgb, var(--radar) 17%, transparent) 359.6deg, transparent 360deg);
    animation: lr-sweep var(--period) linear infinite;
  }
  .sweep::after { content: ""; position: absolute; left: 50%; top: 0; width: 1px; height: 50%; margin-left: -0.5px; background: linear-gradient(to top, color-mix(in srgb, var(--radar) 15%, transparent), var(--radar)); }
  @keyframes lr-sweep { to { transform: rotate(360deg); } }

  /* Echoes: short arcs along the bearing, painted by the sweep, then decaying.
     HTML so the animation stays on the compositor. */
  .echoes { position: absolute; inset: 0; pointer-events: none; }
  .echo {
    position: absolute; width: 7px; height: 2.4px; margin: -1.2px 0 0 -3.5px; border-radius: 2px;
    background: var(--radar); transform: rotate(var(--b));
    animation: lr-paint var(--period) linear infinite; animation-delay: var(--d); opacity: 0.25; will-change: opacity;
  }
  @keyframes lr-paint { 0% { opacity: 1; } 5% { opacity: 0.95; } 55% { opacity: 0.42; } 100% { opacity: 0.22; } }

  /* Tracks (ARPA symbols). */
  .sym { fill: none; stroke-width: 1.3; stroke-dasharray: 1 0; transition: stroke-width 0.3s, opacity 0.3s; }
  .trk-confirmed .sym { stroke: var(--danger); stroke-linejoin: round; }
  .trk-likely .sym { stroke: var(--danger); }
  .trk-suspicious .sym { stroke: var(--amber); stroke-dasharray: 0.06 0.06; }
  .tid { font: 500 7.5px var(--font-mono); fill: var(--text-2); letter-spacing: 0.06em; opacity: 0; transition: opacity 0.25s; paint-order: stroke; stroke: var(--bg); stroke-width: 2.4px; }
  .trk.hot .tid { opacity: 1; }
  .trk.sel .tid { opacity: 0; } /* the data tag carries the ID */
  .trk.hot .sym { stroke-width: 1.9; }
  .trk.sel .sym { stroke-width: 1.9; animation: lr-draw 0.7s var(--ease-out) both; }
  .over.has-sel .trk:not(.sel):not(.hot) { opacity: 0.45; }
  .trk { transition: opacity 0.35s; }
  @keyframes lr-draw { from { stroke-dasharray: 1 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1 0; stroke-dashoffset: 0; } }

  /* Operator tools. */
  .ebl { opacity: 0; transition: opacity 0.25s; }
  .ebl.on { opacity: 1; }
  .vrm { fill: none; stroke: var(--text); stroke-opacity: 0.55; stroke-width: 0.8; stroke-dasharray: 3 3; }
  .eline { stroke: var(--text); stroke-opacity: 0.55; stroke-width: 0.8; stroke-dasharray: 5 3 1 3; }
  .emark { fill: none; stroke: var(--radar); stroke-width: 1.2; }
  .tag { opacity: 0; transition: opacity 0.3s; }
  .tag.on { opacity: 1; }
  .tag.on .lead { animation: lr-draw 0.5s var(--ease-out) both; }
  .lead { fill: none; stroke: var(--text-2); stroke-width: 0.8; }
  .tag-bg { fill: color-mix(in srgb, var(--bg) 86%, transparent); stroke: var(--border-strong); stroke-width: 0.8; }
  .tag-1 { font: 600 8px var(--font-mono); fill: var(--text); letter-spacing: 0.06em; }
  .tag-2 { font: 500 6.8px var(--font-mono); fill: var(--muted); letter-spacing: 0.14em; }
  .own { fill: var(--text); }
  .own-ring { fill: none; stroke: var(--text); stroke-opacity: 0.35; stroke-width: 0.8; }

  /* Operator panel. */
  .ops { width: 100%; max-width: 440px; border: 1px solid var(--border); border-radius: 12px; background: color-mix(in srgb, var(--surface) 80%, transparent); overflow: hidden; }
  .ops-read { display: grid; grid-template-columns: 1.1fr 1fr 1.2fr; border-bottom: 1px solid var(--border); }
  .ops-read > div { display: grid; gap: 5px; padding: 11px 14px 10px; }
  .ops-read > div + div { border-left: 1px solid var(--border); }
  .ops-read .k { font: 500 0.58rem/1 var(--font-mono); letter-spacing: 0.16em; color: var(--muted); }
  .ops-read .v { font: 500 0.86rem/1.1 var(--font-mono); color: var(--text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ops-track { margin: 0; min-height: 3.1em; padding: 10px 14px; font: 400 0.76rem/1.45 var(--font-mono); color: var(--muted); border-bottom: 1px solid var(--border); display: flex; flex-wrap: wrap; gap: 2px 10px; align-items: baseline; }
  .ops-track :global(b) { color: var(--text); font-weight: 600; letter-spacing: 0.04em; }
  .ops-track :global(.d) { color: var(--text); overflow-wrap: anywhere; }
  .ops-track :global(.t) { color: var(--c, var(--muted)); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.68rem; }
  .ops-track :global(a) { margin-left: auto; color: var(--text); white-space: nowrap; }
  .ops-ctl { display: flex; align-items: center; gap: 6px; padding: 8px; }
  .ops-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-width: 32px; height: 30px; padding: 0 8px;
    border: 1px solid var(--border); border-radius: 7px; background: transparent; color: var(--text-2);
    font: 500 0.62rem/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; cursor: var(--cur-pointer);
    transition: color 0.2s, border-color 0.2s, background-color 0.2s, transform 0.2s var(--ease-out);
  }
  .ops-btn:hover:not(:disabled) { color: var(--text); border-color: var(--border-strong); background: var(--surface-2); }
  .ops-btn:active:not(:disabled) { transform: translateY(1px); }
  .ops-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .ops-btn svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ops-btn svg .fill { fill: currentColor; stroke: none; }
  .ops-wide { margin-left: auto; }
  .ops-wide .i-play, .ops-wide[aria-pressed="true"] .i-pause { display: none; }
  .ops-wide[aria-pressed="true"] .i-play { display: block; }
  .ops-count { font: 500 0.7rem/1 var(--font-mono); color: var(--text-2); min-width: 5.6em; text-align: center; font-variant-numeric: tabular-nums; }
  .ops-legend { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 16px; margin: 0; padding: 9px 12px 10px; border-top: 1px solid var(--border); font: 400 0.6rem/1 var(--font-mono); color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; }
  .ops-legend span { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .ops-legend b { font-weight: 500; color: var(--text-2); letter-spacing: 0.02em; }
  .ops-legend svg { width: 11px; height: 11px; }
  .lg { fill: none; stroke-width: 1.4; }
  .lg-c, .lg-l { stroke: var(--danger); }
  .lg-s { stroke: var(--amber); stroke-dasharray: 2 2; }

  .scope.paused .sweep, .scope.paused .echo { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .sweep { animation: none; transform: rotate(70deg); }
    .echo { animation: none; opacity: 0.8; }
    .trk.sel .sym, .tag.on .lead { animation: none; }
  }
</style>
<script>
  // Operator tools for the hero PPI. Optional polish: the panel's buttons are
  // the keyboard path, and nothing here is needed to read the figure.
  type Track = { i: number; t: string; x: number; y: number; b: number; s: number; k: string; d: string; tier: string };
  const fig = document.querySelector<HTMLElement>("figure.radar");
  const scope = fig?.querySelector<HTMLElement>(".scope");
  const over = fig?.querySelector<SVGSVGElement>("svg.over");
  if (fig && scope && over) {
    const C = 220, R = 166, MIN = 0.12, SPAN = 0.8, SNAP = 15;
    const tracks = JSON.parse(fig.querySelector("[data-tracks]")?.textContent || "[]") as Track[];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const ebl = q<SVGGElement>("[data-ebl]"), vrm = q<SVGCircleElement>("[data-vrm]"), eline = q<SVGLineElement>("[data-eline]"), emark = q<SVGCircleElement>("[data-emark]");
    const tag = q<SVGGElement>("[data-tag]"), lead = q<SVGPolylineElement>("[data-lead]"), tagBg = q<SVGRectElement>("[data-tag-bg]");
    const tag1 = q<SVGTextElement>("[data-tag-1]"), tag2 = q<SVGTextElement>("[data-tag-2]");
    const vBrg = q<HTMLElement>("[data-v-brg]"), vRng = q<HTMLElement>("[data-v-rng]"), vZone = q<HTMLElement>("[data-v-zone]");
    const trackEl = q<HTMLElement>("[data-track]"), countEl = q<HTMLElement>("[data-count]");
    const syms = [...over.querySelectorAll<SVGGElement>(".trk")];
    const radarPage = fig.dataset.radarPage ?? "radar/";
    const color = (k: string) => (k === "suspicious" ? "var(--amber)" : "var(--danger)");

    let sel = -1, hot = -1, inside = false, raf = 0;
    const cur = { x: C, y: C }, target = { x: C, y: C };

    const scoreAt = (dist: number) => Math.max(0, Math.min(100, 100 - ((dist / R - MIN) / SPAN) * 60));
    const zone = (s: number) => (s >= 90 ? "CONFIRMED" : s >= 70 ? "LIKELY" : s >= 40 ? "SUSPICIOUS" : "CLEAR");
    const brgOf = (x: number, y: number) => ((Math.atan2(x - C, -(y - C)) * 180) / Math.PI + 360) % 360;
    const fmtB = (b: number) => `${b.toFixed(1).padStart(5, "0")}°`;
    const local = (e: PointerEvent | MouseEvent) => {
      const r = over.getBoundingClientRect();
      return { x: ((e.clientX - r.left) / r.width) * 440, y: ((e.clientY - r.top) / r.height) * 440 };
    };
    const readout = (b: number | null, s: number | null) => {
      vBrg.textContent = b === null ? "–––.–°" : fmtB(b);
      vRng.textContent = s === null ? "–––" : String(Math.round(s)).padStart(3, "0");
      vZone.textContent = s === null ? "—" : zone(s);
      vZone.style.color = s === null ? "" : s >= 70 ? "var(--danger)" : s >= 40 ? "var(--amber)" : "var(--radar)";
    };

    // EBL + VRM, eased toward the pointer (or snapped onto an echo).
    const draw = () => {
      const dx = cur.x - C, dy = cur.y - C, dist = Math.hypot(dx, dy) || 0.001;
      const ex = C + (dx / dist) * R, ey = C + (dy / dist) * R;
      eline.setAttribute("x2", ex.toFixed(2)); eline.setAttribute("y2", ey.toFixed(2));
      vrm.setAttribute("r", Math.min(dist, R).toFixed(2));
      emark.setAttribute("cx", cur.x.toFixed(2)); emark.setAttribute("cy", cur.y.toFixed(2));
      const t = hot >= 0 ? tracks[hot] : null;
      readout(t ? t.b : brgOf(cur.x, cur.y), t ? t.s : scoreAt(dist));
    };
    const tick = () => {
      const k = reduce ? 1 : 0.28;
      cur.x += (target.x - cur.x) * k; cur.y += (target.y - cur.y) * k;
      draw();
      raf = Math.abs(target.x - cur.x) + Math.abs(target.y - cur.y) > 0.05 ? requestAnimationFrame(tick) : 0;
    };
    const aim = () => { if (!raf) raf = requestAnimationFrame(tick); };

    const setHot = (i: number) => {
      if (i === hot) return;
      if (hot >= 0) syms[hot]?.classList.remove("hot");
      hot = i;
      if (hot >= 0) syms[hot]?.classList.add("hot");
      scope.classList.toggle("is-hot", hot >= 0);
    };
    const nearest = (p: { x: number; y: number }) => {
      let best = -1, bd = SNAP;
      tracks.forEach((t, i) => { const d = Math.hypot(t.x - p.x, t.y - p.y); if (d < bd) { bd = d; best = i; } });
      return best;
    };

    // ATC-style data tag on a leader line, kept inside the scope.
    const placeTag = (t: Track) => {
      const w = 92, h = 30, right = t.x < C + 30;
      const bx = right ? t.x + 18 : t.x - 18 - w;
      const by = Math.max(14, Math.min(440 - h - 14, t.y - h - 12));
      const ax = right ? bx : bx + w, ay = by + h;
      lead.setAttribute("points", `${(t.x + (right ? 5 : -5)).toFixed(1)},${(t.y - 5).toFixed(1)} ${ax.toFixed(1)},${ay.toFixed(1)} ${(right ? bx + w : bx).toFixed(1)},${ay.toFixed(1)}`);
      tagBg.setAttribute("x", bx.toFixed(1)); tagBg.setAttribute("y", by.toFixed(1));
      tag1.setAttribute("x", (bx + 8).toFixed(1)); tag1.setAttribute("y", (by + 12).toFixed(1));
      tag2.setAttribute("x", (bx + 8).toFixed(1)); tag2.setAttribute("y", (by + 23).toFixed(1));
      tag1.textContent = `${t.t}  ${String(t.s).padStart(3, "0")}  ${fmtB(t.b)}`;
      tag2.textContent = t.k.toUpperCase();
      tag2.style.fill = color(t.k);
      tag.classList.remove("on"); void tag.getBoundingClientRect(); tag.classList.add("on");
    };

    const idle = trackEl.dataset.idle ?? "";
    const select = (i: number) => {
      if (sel >= 0) syms[sel]?.classList.remove("sel");
      sel = i >= 0 && i !== sel ? i : -1;
      over.classList.toggle("has-sel", sel >= 0);
      countEl.textContent = `${sel >= 0 ? tracks[sel].t : "T––"} / ${String(tracks.length).padStart(2, "0")}`;
      if (sel < 0) {
        tag.classList.remove("on");
        trackEl.textContent = idle;
        if (!inside) readout(null, null);
        return;
      }
      const t = tracks[sel];
      syms[sel]?.classList.add("sel");
      placeTag(t);
      const b = Object.assign(document.createElement("b"), { textContent: t.t });
      const d = Object.assign(document.createElement("span"), { className: "d", textContent: t.d });
      const tier = Object.assign(document.createElement("span"), { className: "t", textContent: `${t.tier} · ${t.s}` });
      tier.style.setProperty("--c", color(t.k));
      const a = Object.assign(document.createElement("a"), { href: `${radarPage}#q=${encodeURIComponent(t.d)}`, textContent: "Inspect →" });
      trackEl.replaceChildren(b, d, tier, a);
      if (!inside) readout(t.b, t.s);
    };

    const leave = () => {
      inside = false;
      ebl.classList.remove("on");
      setHot(-1);
      const t = sel >= 0 ? tracks[sel] : null;
      readout(t ? t.b : null, t ? t.s : null);
    };
    scope.addEventListener("pointermove", (e) => {
      const p = local(e);
      const within = Math.hypot(p.x - C, p.y - C) <= R + 2;
      if (!within) { if (inside) leave(); return; }
      if (!inside) { inside = true; ebl.classList.add("on"); }
      const i = nearest(p);
      setHot(i);
      const snap = i >= 0 ? tracks[i] : p;
      target.x = snap.x; target.y = snap.y;
      aim();
    });
    scope.addEventListener("pointerleave", leave);
    scope.addEventListener("click", (e) => {
      const i = nearest(local(e));
      if (i >= 0) select(i === sel ? -1 : i);
      else if (sel >= 0) select(-1);
    });

    const step = (dir: number) => {
      if (!tracks.length) return;
      const n = tracks.length;
      select(sel < 0 ? (dir > 0 ? 0 : n - 1) : (sel + dir + n) % n);
    };
    fig.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((btn) => btn.addEventListener("click", () => step(Number(btn.dataset.step))));
    fig.addEventListener("keydown", (e) => {
      if (!(e.target as HTMLElement).closest(".ops-ctl")) return;
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
    });

    // WCAG 2.2.2: the sweep runs forever, so it can be paused.
    const toggle = q<HTMLButtonElement>("[data-sweep-toggle]");
    toggle.addEventListener("click", () => {
      const paused = scope.classList.toggle("paused");
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.querySelector(".t")!.textContent = paused ? "Resume" : "Pause";
      toggle.setAttribute("aria-label", paused ? "Resume sweep" : "Pause sweep");
    });
  }
</script>
