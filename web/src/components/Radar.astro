---
// Signature instrument: a radar scope whose contacts are the real (or clearly
// labelled demo) indicators. Bearing is a stable hash of the domain; range is
// the score: the closer to the centre, the more certain the verdict. Rings sit
// on the tier thresholds (90 CONFIRMED, 70 LIKELY, 40 SUSPICIOUS). Likely and
// confirmed contacts are marked (ring / lock brackets) as the sweep passes.
// Respects prefers-reduced-motion (static frame).
import { all, polar, defang } from "../lib/site";

const PERIOD = 7;
const C = 220;
const R = 176;
const range = (score: number) => 0.12 + (Math.min(100, Math.max(40, score)) - 100) / -60 * 0.8;
const items = all.indicators.filter((i) => i.status === "active");
const contacts = items
  .map((i) => {
    const { angle } = polar(i.domain);
    const r = range(i.score);
    const rad = ((angle - 90) * Math.PI) / 180;
    return {
      x: C + Math.cos(rad) * R * r,
      y: C + Math.sin(rad) * R * r,
      angle,
      delay: -((360 - angle) / 360) * PERIOD,
      kind: i.tier === "confirmed" || i.score >= 90 ? "confirmed" : i.tier === "likely" ? "likely" : "suspicious",
      color: i.tier === "suspicious" ? "var(--amber)" : "var(--danger)",
      label: defang(i.domain),
      score: i.score,
    };
  })
  .sort((a, b) => b.score - a.score);
const top = contacts.slice(0, 3);
const rings = [
  { score: 90, label: "90 · CONFIRMED" },
  { score: 70, label: "70 · LIKELY" },
  { score: 40, label: "40 · SUSPICIOUS" },
];
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
const pt = (deg: number, rr: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + Math.cos(a) * rr, C + Math.sin(a) * rr];
};
---
<figure class="radar" aria-labelledby="radar-cap">
  <div class="scope" style={`--period:${PERIOD}s`}>
    <div class="glass" aria-hidden="true"></div>
    <div class="sweep" aria-hidden="true"></div>
    <svg viewBox="0 0 440 440" aria-hidden="true">
      <circle cx={C} cy={C} r={R + 16} fill="none" stroke="var(--border-strong)" stroke-width="1" />
      {ticks.map((d) => {
        const major = d % 30 === 0;
        const [x1, y1] = pt(d, R + (major ? 4 : 9));
        const [x2, y2] = pt(d, R + 16);
        return <line x1={x1.toFixed(1)} y1={y1.toFixed(1)} x2={x2.toFixed(1)} y2={y2.toFixed(1)} stroke={major ? "var(--muted)" : "var(--border-strong)"} stroke-width={major ? 1.2 : 1} />;
      })}
      {ticks.filter((d) => d % 30 === 0).map((d) => {
        const [x, y] = pt(d, R + 29);
        return <text x={x.toFixed(1)} y={(y + 3).toFixed(1)} class="deg">{String(d).padStart(3, "0")}</text>;
      })}
      <circle cx={C} cy={C} r={R} fill="none" stroke="var(--radar)" stroke-opacity=".45" stroke-width="1.2" />
      {rings.map((g) => (
        <circle cx={C} cy={C} r={(R * range(g.score)).toFixed(1)} fill="none" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="2 4" />
      ))}
      <path d={`M${C - R} ${C}H${C + R}M${C} ${C - R}V${C + R}`} stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="1 5" />
      {rings.map((g) => (
        <g>
          <line x1={(C + R * range(g.score)).toFixed(1)} y1={C - 4} x2={(C + R * range(g.score)).toFixed(1)} y2={C + 4} stroke="var(--muted)" stroke-width="1" />
          <text x={(C + R * range(g.score)).toFixed(1)} y={C + 15} class="ring-label">{g.score}</text>
        </g>
      ))}
      <circle cx={C} cy={C} r="3" fill="var(--radar)" />
      <circle cx={C} cy={C} r="9" fill="none" stroke="var(--radar)" stroke-opacity=".35" />
    </svg>
    <div class="layer" aria-hidden="true">
      {contacts.map((b) => (
        <span class={`c ${b.kind}`} style={`left:${(b.x / 4.4).toFixed(2)}%;top:${(b.y / 4.4).toFixed(2)}%;--d:${b.delay.toFixed(2)}s;--c:${b.color}`}>
          <i class="halo"></i>
          <i class="blip"></i>
          {b.kind === "likely" && <i class="mark ring"></i>}
          {b.kind === "confirmed" && (
            <svg class="mark" viewBox="-9 -9 18 18"><path d="M-8 -4V-8H-4M4 -8H8V-4M8 4V8H4M-4 8H-8V4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" /></svg>
          )}
        </span>
      ))}
    </div>
  </div>
  <figcaption>
    <p id="radar-cap" class="cap">
      <span>{contacts.length} contact{contacts.length === 1 ? "" : "s"}</span>
      <span aria-hidden="true">·</span>
      <span>range = score · rings at 90 / 70 / 40</span>
    </p>
    {top.length > 0 && (
      <ol class="contacts">
        {top.map((c) => (
          <li><span class="brg">{String(c.angle).padStart(3, "0")}°</span><span class="dom">{c.label}</span><span class="sc" style={`color:${c.color}`}>{c.score}</span></li>
        ))}
      </ol>
    )}
  </figcaption>
</figure>
<style>
  .radar { margin: 0; display: grid; gap: 18px; justify-items: center; }
  .scope { position: relative; width: 100%; max-width: 540px; aspect-ratio: 1; }
  .scope > svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .glass {
    position: absolute; inset: 10%; border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--radar) 9%, transparent), transparent 70%);
  }
  .sweep {
    position: absolute; inset: 10%; border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0deg 285deg, color-mix(in srgb, var(--radar) 4%, transparent) 300deg, color-mix(in srgb, var(--radar) 30%, transparent) 359.5deg, transparent 360deg);
    animation: lr-sweep var(--period) linear infinite;
  }
  .sweep::after {
    content: ""; position: absolute; left: 50%; top: 0; width: 1.5px; height: 50%; margin-left: -0.75px;
    background: linear-gradient(to top, transparent, var(--radar) 70%);
    box-shadow: 0 0 12px var(--radar);
  }
  .deg { font: 400 8.5px var(--font-mono); fill: var(--muted); text-anchor: middle; letter-spacing: 0.06em; }
  .ring-label { font: 400 8px var(--font-mono); fill: var(--muted); text-anchor: middle; }
  /* Contacts are HTML so their animations run on the compositor, not the main thread. */
  .layer { position: absolute; inset: 0; }
  .c { position: absolute; width: 0; height: 0; color: var(--c); }
  .c > * { position: absolute; display: block; border-radius: 50%; animation-duration: var(--period); animation-timing-function: linear; animation-iteration-count: infinite; animation-delay: var(--d); will-change: transform, opacity; }
  .blip { width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; background: currentColor; animation-name: lr-blip; }
  .suspicious .blip { background: var(--bg); box-shadow: inset 0 0 0 1.6px currentColor; }
  .halo { width: 8px; height: 8px; margin: -4px 0 0 -4px; border: 1px solid currentColor; opacity: 0; animation-name: lr-halo; }
  .mark.ring { width: 15px; height: 15px; margin: -7.5px 0 0 -7.5px; border: 1.1px solid currentColor; animation-name: lr-mark; }
  svg.mark { max-width: none; width: 19px; height: 19px; margin: -9.5px 0 0 -9.5px; border-radius: 0; overflow: visible; animation-name: lr-mark; }
  @keyframes lr-sweep { to { transform: rotate(360deg); } }
  @keyframes lr-blip { 0% { opacity: 1; transform: scale(1.7); } 6% { opacity: 1; transform: scale(1); } 65% { opacity: 0.55; } 100% { opacity: 0.4; transform: scale(1); } }
  @keyframes lr-halo { 0% { opacity: 0.9; transform: scale(1); } 20%, 100% { opacity: 0; transform: scale(4); } }
  @keyframes lr-mark { 0%, 3% { opacity: 0; transform: scale(1.8); } 11% { opacity: 1; transform: scale(1); } 70% { opacity: 0.8; } 100% { opacity: 0.3; transform: scale(1); } }
  figcaption { width: 100%; max-width: 440px; }
  .cap { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin: 0 0 12px; font: 400 0.72rem/1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .contacts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); font: 400 0.78rem/1.4 var(--font-mono); }
  .contacts li { display: grid; grid-template-columns: 52px 1fr auto; gap: 12px; padding: 9px 2px; border-bottom: 1px solid var(--border); }
  .brg { color: var(--muted); }
  .dom { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    .sweep { animation: none; transform: rotate(70deg); }
    .c > * { animation: none !important; }
    .blip, .mark { opacity: 0.9; }
  }
</style>
