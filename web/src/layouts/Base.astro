---
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { NAV, PRIMARY_NAV, abs, href, meta, stats, pcwatch, fmtUtc, REPO_URL, issueUrl } from "../lib/site";

interface Props {
  title: string;
  description: string;
  og?: string;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, og = "default", jsonld, noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).toString();
const ogImage = abs(`og/${og}.png`);
const fullTitle = title.includes("LureRadar") ? title : `${title} · LureRadar`;
const current = (p: string) => {
  const target = href(p);
  return p === "" ? pathname === target : pathname.startsWith(target);
};
const updated = stats.generated_at ?? meta.generated_at;
const pcStatus = String(pcwatch.status ?? "UNKNOWN").replaceAll("_", " ");
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const year = new Date(updated ?? Date.now()).getUTCFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0A0B0A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F3F1EA" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href("apple-touch-icon.png")} />
    <link rel="manifest" href={href("site.webmanifest")} />
    <link rel="alternate" type="application/atom+xml" title="LureRadar PC Watch" href={href("feeds/pc-watch.atom")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LureRadar" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, "\\u003c")} />)}
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        var t = localStorage.getItem("lr-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="freshness">
      <div class="wrap">
        <span><span class="dot" id="fresh-dot" aria-hidden="true"></span>Feed updated <time id="fresh-time" datetime={updated ?? ""}>{fmtUtc(updated)}</time> <span id="fresh-age" class="rail-age"></span></span>
        {meta.demo && <><span class="sep" aria-hidden="true"></span><span class="rail-demo">Demo data<span class="rail-long"> · synthetic fixtures on reserved .test domains</span></span></>}
        <span class="rail-right">Refreshed daily · PC Watch every 4 h</span>
      </div>
    </div>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href("")} aria-label="LureRadar home"><Logo /><span>Lure<b>Radar</b></span></a>
        <nav class="nav" aria-label="Main">
          {PRIMARY_NAV.map((n) => <a href={href(n.path)} aria-current={current(n.path) ? "page" : undefined}>{n.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="btn primary header-cta" href={href("check/")}>Check a link <span class="arr" aria-hidden="true">→</span></a>
          <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Colour theme: Auto (click to change)" title="Colour theme">
            <svg class="i i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor" stroke="none" /></svg>
            <svg class="i i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
            <svg class="i i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
          </button>
          <details class="menu">
            <summary class="icon-btn" aria-label="Open menu"><span class="bars" aria-hidden="true"></span></summary>
            <nav class="menu-panel" aria-label="Main (mobile)">
              {NAV.map((n, i) => (
                <a href={href(n.path)} aria-current={current(n.path) ? "page" : undefined} style={`--i:${i}`}>
                  {n.label}<span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                </a>
              ))}
              <div class="menu-foot" style="--i:10">
                <a class="btn primary" href={href("check/")}>Check a link</a>
                <a class="btn" href={REPO_URL}>Source on GitHub</a>
              </div>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-cta" data-reveal>
          <h2>Scammers move fast at launch. <em>So should your blocklist.</em></h2>
          <div class="actions">
            <a class="btn primary" href={href("feeds/")}>Get the blocklists <span class="arr" aria-hidden="true">→</span></a>
            <a class="btn" href={href("check/")}>Check a link</a>
          </div>
        </div>
        <div class="footer-cols">
          <div>
            <a class="brand" href={href("")} aria-label="LureRadar home"><Logo size={26} /><span>Lure<b>Radar</b></span></a>
            <p style="margin-top:16px;max-width:30ch">An open, explainable threat radar for hyped-launch scams. Built in public, for players and the people who protect them.</p>
          </div>
          <div>
            <h2>Product</h2>
            <ul>
              <li><a href={href("check/")}>Check a link</a></li>
              <li><a href={href("radar/")}>Radar</a></li>
              <li><a href={href("feeds/")}>Blocklists</a></li>
              <li><a href={href("pc-watch/")}>PC Watch</a></li>
            </ul>
          </div>
          <div>
            <h2>Project</h2>
            <ul>
              <li><a href={href("docs/")}>Docs</a></li>
              <li><a href={href("methodology/")}>Methodology</a></li>
              <li><a href={href("packs/")}>Campaign packs</a></li>
              <li><a href={href("report/")}>Report a lure</a></li>
              <li><a href={REPO_URL}>Source code</a></li>
            </ul>
          </div>
          <div>
            <h2>Trust</h2>
            <ul>
              <li><a href={href("about/")}>About</a></li>
              <li><a href={href("ethics/")}>Ethics &amp; abuse</a></li>
              <li><a href={href("privacy/")}>Privacy</a></li>
              <li><a href={href("bot/")}>Crawler (bot) info</a></li>
              <li><a href={issueUrl("false-positive-review.yml")}>Dispute a listing</a></li>
            </ul>
          </div>
          <div>
            <h2>Status</h2>
            <dl class="footer-status">
              <div><dt>Feed</dt><dd>{fmtUtc(updated)}{meta.demo ? " · demo" : ""}</dd></div>
              <div><dt>PC Watch</dt><dd>{pcStatus}</dd></div>
              <div><dt>Release</dt><dd>v{meta.version} · MIT · data CC0-1.0</dd></div>
            </dl>
          </div>
        </div>
        <div class="footer-base">
          <p class="disclaimer">
            LureRadar is an independent project, not affiliated with, endorsed by, or sponsored by Rockstar Games, Take-Two Interactive, or any platform holder. All trademarks belong to their owners.
            Detections are automated and may contain false positives; no warranty. No trackers, no cookies.
          </p>
          <a class="to-top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      </div>
      <p class="wordmark" aria-hidden="true">Lure<em>Radar</em></p>
      <p class="visually-hidden">© {year} LureRadar contributors.</p>
    </footer>
    <script>
      import { initChrome } from "../lib/chrome";
      initChrome();
    </script>
  </body>
</html>
<style>
  .header-cta { min-height: 38px; padding: 0 15px; font-size: 0.85rem; border-radius: 10px; }
  .rail-right { margin-left: auto; }
  .rail-demo { color: var(--amber); }
  .rail-age::before { content: "· "; }
  .rail-age:empty::before { content: none; }
  @media (max-width: 760px) { .rail-right { display: none; } }
</style>
