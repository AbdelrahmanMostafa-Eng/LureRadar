---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { href, REPO_URL } from "../../lib/site";
import { listDocs, DOC_ORDER } from "../../lib/docs";
const docs = listDocs().filter((d) => d.slug !== "index");
const rank = (slug: string) => (DOC_ORDER.indexOf(slug) < 0 ? 100 : DOC_ORDER.indexOf(slug));
docs.sort((a, b) => rank(a.slug) - rank(b.slug) || a.title.localeCompare(b.title));
---
<Base title="Documentation" description="LureRadar documentation: quickstart, how it works, signals, feeds, PC Watch, campaign packs, JSON schema, data sources, benchmarks, threat model and privacy." og="default">
  <PageHeader eyebrow="Documentation" title="Read the" em="manual.">
    <p>Rendered from the repository's <a href={`${REPO_URL}/tree/main/docs`}>docs/</a> folder at build time. Start with the quickstart; the threat model and decisions log explain the why.</p>
  </PageHeader>
  <div class="wrap">
    {docs.length ? (
      <ol class="doclist">
        {docs.map((d, i) => (
          <li data-reveal style={`--i:${i % 6}`}>
            <a href={href(`docs/${d.slug}/`)}>
              <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
              <span class="t">{d.title}</span>
              <span class="f mono">{d.file}</span>
              <span class="arr" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    ) : <div class="empty"><strong>No documents found</strong>Docs live in the repository's docs/ folder.</div>}
  </div>
</Base>
<style>
  .doclist { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .doclist a { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto 28px; gap: 18px; align-items: baseline; padding: 22px 6px; border-bottom: 1px solid var(--border); color: var(--text); text-decoration: none; transition: background-color 0.25s, padding-left 0.5s var(--ease-out); }
  .doclist a:hover { background: var(--surface); padding-left: 16px; }
  .n { color: var(--muted); font-size: 0.78rem; }
  .t { font: 650 clamp(1.5rem, 2.4vw, 1.95rem)/1.1 var(--font-display); font-stretch: 75%; }
  .f { color: var(--muted); font-size: 0.78rem; }
  .arr { color: var(--muted); transition: transform 0.45s var(--ease-out), color 0.25s; }
  .doclist a:hover .arr { transform: translateX(4px); color: var(--radar); }
  @media (max-width: 640px) { .doclist a { grid-template-columns: 40px minmax(0, 1fr) 20px; } .f { display: none; } }
</style>
