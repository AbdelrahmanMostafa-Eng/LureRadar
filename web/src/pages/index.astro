---
import Base from "../layouts/Base.astro";
import Radar from "../components/Radar.astro";
import TierBadge from "../components/TierBadge.astro";
import CopyBlock from "../components/CopyBlock.astro";
import DemoNotice from "../components/DemoNotice.astro";
import { abs, href, latest, stats, pcwatch, meta, defang, fmtUtc, fmtDate, REPO_URL, TIER_COLOR } from "../lib/site";

const recent = [...latest.indicators].sort((a, b) => b.first_seen.localeCompare(a.first_seen)).slice(0, 6);
const new24 = stats.new_24h ?? 0;
const shareText = new24
  ? `Today: ${new24} new fake GTA 6 download site${new24 === 1 ? "" : "s"} caught by LureRadar${meta.demo ? " (demo data)" : ""}.`
  : "LureRadar: free blocklists and an offline checker for fake GTA 6 downloads and launch scams.";
const pcStatus = String(pcwatch.status ?? "UNKNOWN");
const pcTone = pcStatus === "NOT_ANNOUNCED" ? "var(--radar)" : pcStatus === "UNKNOWN" ? "var(--muted)" : "var(--amber)";
const pcWord = pcStatus.replaceAll("_", " ").toLowerCase();
const confirmed = String(pcwatch.confirmed_status ?? "unknown").replaceAll("_", " ").toLowerCase();
const feed = (f: string) => abs(`feeds/${f}`);
const recipes = [
  { id: "pihole", name: "Pi-hole", steps: "Settings → Lists → add this address → Update Gravity (or pihole -g).", url: feed("hosts.txt") },
  { id: "adguard", name: "AdGuard", steps: "AdGuard Home: Filters → DNS blocklists → Add blocklist → Add a custom list.", url: feed("adguard.txt") },
  { id: "ubo", name: "uBlock Origin", steps: "Dashboard → Filter lists → Import → paste the address → Apply changes.", url: feed("adguard.txt") },
  { id: "rpz", name: "DNS (RPZ)", steps: "Response Policy Zone for Unbound, BIND, Knot and PowerDNS. Names answer NXDOMAIN, subdomains included.", url: feed("rpz.zone") },
];
const jsonld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LureRadar",
  applicationCategory: "SecurityApplication",
  operatingSystem: "Linux, macOS, Windows",
  description: "Open threat radar for hyped-launch scams: fake downloads, key-gen traps and phishing, starting with GTA 6. Free blocklists, offline CLI, explainable scores.",
  url: abs(""),
  codeRepository: REPO_URL,
  license: "https://opensource.org/licenses/MIT",
  softwareVersion: meta.version,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---
<Base title="LureRadar: GTA 6 scam & fake download blocklist" description="Is that GTA 6 PC download real? LureRadar detects fake GTA 6 downloads, key-gen traps and phishing lures. Free GTA 6 blocklist for Pi-hole, AdGuard and uBlock Origin, plus an offline checker." og="stats" jsonld={jsonld}>
  <div class="hero-shell">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow intro">Threat radar · hyped-launch scams</p>
      <h1 class="hero-title lines">
        <span class="line"><span style="--i:0">See the lure</span></span>
        <span class="line"><span style="--i:1">before you</span></span>
        <span class="line"><span style="--i:2"><em class="warn">bite.</em></span></span>
      </h1>
      <p class="lede intro" style="--i:2">
        LureRadar spots <strong>fake GTA 6 PC downloads</strong>, key-generator traps and phishing lures around big releases,
        explains every verdict, and turns them into a free <strong>GTA 6 scam blocklist</strong> for Pi-hole, AdGuard and uBlock Origin.
      </p>
      <form class="hero-form intro" style="--i:3" id="home-check" action={href("check/")} method="get" role="search">
        <label for="home-q" class="visually-hidden">Link, domain or message to check</label>
        <div class="command">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4" /><path d="M12 12 18 6" /></svg>
          <input id="home-q" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="Paste a link or a message" />
          <button class="btn primary" type="submit">Check <span class="arr" aria-hidden="true">→</span></button>
        </div>
        <p class="hint">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" /></svg>
          Runs in your browser. Nothing you type is sent anywhere.
        </p>
      </form>
      <div class="hero-links intro" style="--i:4">
        <a class="arrow-link" href={href("feeds/")}><span class="txt">Get the blocklists</span> <span class="arr" aria-hidden="true">→</span></a>
        <a class="arrow-link" href={href("pc-watch/")}><span class="txt">Is GTA 6 coming to PC?</span> <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-radar intro" style="--i:3">
      <Radar />
    </div>
  </div>
  </div>

  <section class="wrap" aria-labelledby="stats-h">
    <h2 id="stats-h" class="visually-hidden">Live statistics</h2>
    <div class="readout" data-reveal>
      <div>
        <div class="value" style={new24 ? "color:var(--danger)" : undefined} data-count={new24}>{new24}</div>
        <div class="label label-caps">New lure sites · 24 h</div>
      </div>
      <div>
        <div class="value" data-count={stats.active_listed ?? 0}>{stats.active_listed ?? 0}</div>
        <div class="label label-caps">In the blocklists</div>
      </div>
      <div>
        <div class="value" style="color:var(--amber)" data-count={stats.suspicious ?? 0}>{stats.suspicious ?? 0}</div>
        <div class="label label-caps">On watch, not blocked</div>
      </div>
      <div>
        <div class="value date"><time datetime={stats.generated_at ?? ""}>{fmtUtc(stats.generated_at)}</time></div>
        <div class="label label-caps">Feed generated</div>
      </div>
    </div>
    <div class="share-row" data-reveal>
      <DemoNotice />
      <button type="button" class="btn small" id="share" data-text={shareText} data-url={abs("")}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" /></svg>
        Share these stats
      </button>
    </div>
  </section>

  <section class="wrap dispatch-grid" aria-label="Latest detections and PC Watch">
    <div class="dispatch">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow"><span class="idx">01</span>Latest detections</p>
          <h2>Fresh off <em>the scope.</em></h2>
        </div>
        <a class="arrow-link" href={href("radar/")}><span class="txt">Open the radar</span> <span class="arr" aria-hidden="true">→</span></a>
      </div>
      {recent.length ? (
        <ol class="log">
          {recent.map((i, n) => (
            <li data-reveal style={`--i:${n}`}>
              <TierBadge tier={i.tier} />
              <span class="dom mono">{defang(i.domain)}</span>
              <span class="sc mono"><span class="bar" aria-hidden="true"><i style={`width:${i.score}%;background:${TIER_COLOR[i.tier] ?? "var(--muted)"}`}></i></span><span class="num">{i.score}</span></span>
              <time class="mono muted" datetime={i.first_seen}>{fmtDate(i.first_seen)}</time>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty"><strong>The radar is quiet</strong>No active detections. New indicators appear after each daily run.</div>
      )}
    </div>
    <aside class="bulletin card" aria-labelledby="pc-h" data-reveal style="--i:2">
      <p class="label-caps" id="pc-h">PC Watch · official sources only</p>
      <p class="pc-word" style={`--tone:${pcTone}`}><span class="lamp live" aria-hidden="true"></span>{pcWord}</p>
      <p class="pc-text">{pcStatus === "UNKNOWN"
        ? `No successful automated check in the last 36 hours, so we won't repeat an old answer. Maintainer-confirmed status: ${confirmed} (as of ${pcwatch.confirmed_as_of ?? "?"}).`
        : (pcwatch.answer ?? "Official sources only.")}</p>
      <p class="muted small">Rockstar Newswire, Take-Two releases and filings, official stores. A status change always needs a maintainer to confirm it.</p>
      <a class="arrow-link" href={href("pc-watch/")}><span class="txt">Read the evidence</span> <span class="arr" aria-hidden="true">→</span></a>
    </aside>
  </section>

  <section class="wrap method" aria-labelledby="how-h">
    <div class="method-head" data-reveal>
      <p class="eyebrow"><span class="idx">02</span>Method</p>
      <h2 id="how-h">Three steps. <em>No black box.</em></h2>
      <p class="muted">Every score is a sum of named signals with fixed weights and the evidence behind them. No machine-learning model and no LLM decides anything.</p>
      <a class="arrow-link" href={href("methodology/")}><span class="txt">Read the methodology</span> <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <ol class="steps">
      <li data-reveal>
        <span class="n" aria-hidden="true">01</span>
        <div>
          <h3>Watch</h3>
          <p>Certificate Transparency, public phishing feeds and community reports surface new launch-themed domains every day.</p>
          <p class="artifact mono">crt.sh · OpenPhish · URLhaus · urlscan.io · CT stream · community reports</p>
        </div>
      </li>
      <li data-reveal>
        <span class="n" aria-hidden="true">02</span>
        <div>
          <h3>Explain</h3>
          <p>Named signals with fixed weights: fake PC version, brand impersonation, new domain, lure page patterns. Keywords alone never flag a site.</p>
          <p class="artifact mono"><span class="w-pos">+30</span> claims_unreleased_platform<br /><span class="w-pos">+25</span> brand_impersonation<br /><span class="w-pos">+20</span> keyword_intent_combo<br /><span class="eq">= 75 · likely lure</span></p>
        </div>
      </li>
      <li data-reveal>
        <span class="n" aria-hidden="true">03</span>
        <div>
          <h3>Block</h3>
          <p>LIKELY and CONFIRMED indicators become signed, CC0 blocklists. Suspicious ones stay on watch, never blocked.</p>
          <p class="artifact mono">hosts · domains · adblock · RPZ · STIX 2.1 · CSV · JSON · minisign</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="wrap cli" aria-labelledby="cli-h">
    <div class="cli-copy" data-reveal>
      <p class="eyebrow"><span class="idx">03</span>Command line</p>
      <h2 id="cli-h">Same engine, <em>in your terminal.</em></h2>
      <p class="muted">Offline by default: no network connection unless you ask for <code>--live</code>. Exit codes 0 / 10 / 20 / 30 make it easy to wire into scripts, bots and CI.</p>
      <CopyBlock text={`uvx lureradar check "hxxps://rockstar-gta6-pc-download[.]test/free-key"`} label="Copy CLI example" />
    </div>
    <div class="terminal" data-reveal style="--i:1">
      <div class="terminal-bar"><span>lureradar check</span><span>exit 20</span></div>
<pre tabindex="0" role="region" aria-label="Example lureradar check output"><span class="t-dim">$</span> <span class="t-hi">uvx lureradar check "hxxps://rockstar-gta6-pc-download[.]test/free-key"</span>

  <span class="t-bad">LIKELY LURE</span>   <span class="t-hi">75</span><span class="t-dim">/100</span>  <span class="t-meter" aria-hidden="true"><i style="width:22ch"></i><b style="left:27ch"></b></span>

  <span class="t-hi">hxxps://rockstar-gta6-pc-download[.]test/free-key</span>
  Looks like a launch lure: unreleased platform + brand impersonation

  <span class="t-dim">WHY</span>
    <span class="t-bad">+30</span>  <span class="t-hi">claims_unreleased_platform</span>  Promises "download" of GTA VI for PC:
                                     no official PC release exists
    <span class="t-bad">+25</span>  <span class="t-hi">brand_impersonation</span>         Combosquat: "rockstar" plus other words
    <span class="t-bad">+20</span>  <span class="t-hi">keyword_intent_combo</span>        Keyword "gta6" + intent "pc", "download"

  <span class="t-dim">WHAT TO DO NEXT</span>
  <span class="t-ok">›</span> Do not visit, download, enter credentials or pay.
  <span class="t-ok">›</span> Block it: subscribe to the LureRadar feeds.

  <span class="t-dim">packs: gta6 · offline · exit 20 · v{meta.version}</span></pre>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="block-h">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="idx">04</span>Blocklists</p>
        <h2 id="block-h">Block the campaign <em>in a minute.</em></h2>
      </div>
      <a class="arrow-link" href={href("feeds/")}><span class="txt">All formats and verification</span> <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <div class="tabs card" data-tabs data-reveal>
      <div class="tablist" role="tablist" aria-label="Blocklist setup">
        {recipes.map((r, i) => <button type="button" role="tab" id={`tab-${r.id}`} aria-controls={`panel-${r.id}`} aria-selected={i === 0 ? "true" : "false"}>{r.name}</button>)}
        <span class="tab-ink" aria-hidden="true"></span>
      </div>
      {recipes.map((r) => (
        <div class="tabpanel" role="tabpanel" id={`panel-${r.id}`} aria-labelledby={`tab-${r.id}`} tabindex="0">
          <h3 class="panel-title">{r.name}</h3>
          <p>{r.steps}</p>
          <CopyBlock text={r.url} label={`Copy ${r.name} list URL`} />
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .hero-bg {
    position: absolute; inset: -120px 0 -80px 0; pointer-events: none; z-index: -1;
    /* plotting grid, like the chart a radar operator works on */
    background:
      radial-gradient(ellipse 50% 46% at 76% 40%, color-mix(in srgb, var(--radar) 8%, transparent), transparent 70%),
      linear-gradient(to right, var(--grid) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(to bottom, var(--grid) 1px, transparent 1px) 0 0 / 64px 64px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 35%, #000 25%, transparent 78%);
  }
  .hero-shell { position: relative; isolation: isolate; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding-top: clamp(40px, 6vw, 88px); }
  .hero-title { font-size: clamp(3.9rem, 8.4vw, 7.8rem); font-stretch: 62%; line-height: 0.84; letter-spacing: 0.005em; margin: 0 0 30px; white-space: nowrap; }
  .hero-form { margin: 34px 0 0; max-width: 620px; }
  .hint { display: flex; align-items: center; gap: 8px; margin: 12px 2px 0; color: var(--muted); font-size: 0.84rem; }
  .hint svg { width: 14px; height: 14px; flex-shrink: 0; }
  .hero-links { display: flex; gap: 14px 28px; flex-wrap: wrap; margin-top: 30px; }
  .hero-radar { min-width: 0; }
  @media (max-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero-radar { max-width: 440px; width: 100%; margin: 8px auto 0; }
  }

  .share-row { display: flex; gap: 12px 24px; align-items: center; justify-content: space-between; margin-top: 18px; flex-wrap: wrap; }

  .dispatch-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  @media (max-width: 960px) { .dispatch-grid { grid-template-columns: minmax(0, 1fr); } }
  .log { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .log li {
    display: grid; grid-template-columns: 150px minmax(0, 1fr) 120px 96px; gap: 16px; align-items: center;
    padding: 15px 4px; border-bottom: 1px solid var(--border); font-size: 0.9rem;
    transition: background-color 0.25s, padding-left 0.45s var(--ease-out);
  }
  .log li:hover { background: color-mix(in srgb, var(--surface) 60%, transparent); padding-left: 10px; }
  .log .dom { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
  .log .sc { display: flex; align-items: center; gap: 10px; justify-content: flex-end; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .log .sc::after { content: ""; }
  .log .num { min-width: 3ch; text-align: right; }
  .log .bar { width: 64px; height: 4px; border-radius: 4px; background: var(--border); overflow: hidden; }
  .log .bar i { display: block; height: 100%; border-radius: 4px; }
  .log time { text-align: right; font-size: 0.8rem; }
  @media (max-width: 640px) {
    .log li { grid-template-columns: minmax(0, 1fr) auto; gap: 8px 12px; }
    .log .dom { grid-column: 1 / -1; grid-row: 1; }
    .log time { display: none; }
  }
  .bulletin { display: grid; gap: 14px; align-content: start; margin-top: 8px; background: linear-gradient(180deg, var(--surface), var(--bg-2)); }
  .bulletin p { margin: 0; }
  .pc-word { display: flex; align-items: center; gap: 16px; font: 700 clamp(2.8rem, 4.6vw, 3.8rem)/0.9 var(--font-display); font-stretch: 64%; color: var(--tone); text-transform: uppercase; margin: 6px 0 2px !important; }
  .pc-word .lamp { --c: var(--tone); width: 11px; height: 11px; }
  .pc-text { color: var(--text-2); }

  .method { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .method-head { position: sticky; top: calc(var(--header-h) + 40px); }
  .method-head h2 { margin-top: 0; }
  .method-head p.muted { max-width: 34em; }
  @media (max-width: 960px) { .method { grid-template-columns: minmax(0, 1fr); } .method-head { position: static; } }
  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .steps li { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 20px; padding: 34px 0 36px; border-bottom: 1px solid var(--border); }
  .steps .n { font: 700 3.8rem/0.82 var(--font-display); font-stretch: 62%; color: transparent; -webkit-text-stroke: 1px var(--border-strong); }
  .steps h3 { margin: 2px 0 12px; font: 700 2.2rem/0.95 var(--font-display); font-stretch: 68%; text-transform: uppercase; letter-spacing: 0.01em; }
  .steps p { color: var(--text-2); margin-bottom: 16px; }
  .artifact { margin: 0 !important; padding: 12px 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-2); color: var(--muted) !important; font-size: 0.78rem; line-height: 1.75; }
  .artifact .eq { display: inline-block; margin-top: 4px; padding-top: 4px; border-top: 1px solid var(--border-strong); color: var(--danger); }
  @media (max-width: 560px) { .steps li { grid-template-columns: minmax(0, 1fr); gap: 8px; } }

  .cli { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .cli h2 { margin-top: 0; }
  .cli-copy code { white-space: nowrap; }
  @media (max-width: 960px) { .cli { grid-template-columns: minmax(0, 1fr); } }

  .tabs { padding: 0; overflow: hidden; }
  .tablist { position: relative; display: none; gap: 4px; padding: 8px; border-bottom: 1px solid var(--border); overflow-x: auto; }
  :global(.js) .tablist { display: flex; }
  .tablist [role="tab"] {
    position: relative; z-index: 1; border: 0; background: none; color: var(--muted); cursor: pointer;
    font: 500 0.9rem/1 var(--font-ui); padding: 12px 16px; border-radius: 9px; white-space: nowrap; transition: color 0.3s;
  }
  .tablist [role="tab"][aria-selected="true"] { color: var(--text); }
  .tab-ink { position: absolute; z-index: 0; top: 8px; bottom: 8px; left: 0; width: 0; border-radius: 9px; background: var(--surface-2); border: 1px solid var(--border-strong); transition: transform 0.5s var(--ease-out), width 0.5s var(--ease-out); }
  .tabpanel { padding: clamp(20px, 3vw, 32px); }
  .tabpanel + .tabpanel { border-top: 1px solid var(--border); }
  :global(.js) .tabpanel + .tabpanel { border-top: 0; }
  .tabpanel p { color: var(--text-2); margin: 0; }
  .panel-title { margin: 0 0 8px; }
  :global(.js) .panel-title { display: none; }
  .tabpanel:not([hidden]) { animation: lr-fade 0.5s ease both; }
</style>
<script>
  const form = document.getElementById("home-check") as HTMLFormElement | null;
  form?.addEventListener("submit", (ev) => {
    // keep the query in the URL fragment: fragments are never sent to the server
    ev.preventDefault();
    const q = (document.getElementById("home-q") as HTMLInputElement).value.trim();
    location.href = `${form.action}#q=${encodeURIComponent(q)}`;
  });
  const share = document.getElementById("share") as HTMLButtonElement | null;
  share?.addEventListener("click", async () => {
    const text = share.dataset.text ?? "";
    const url = share.dataset.url ?? location.href;
    if (navigator.share) {
      try { await navigator.share({ title: "LureRadar", text, url }); return; } catch { /* cancelled */ }
    }
    window.open(`https://x.com/intent/post?text=${encodeURIComponent(`${text} ${url}`)}`, "_blank", "noopener");
  });
</script>
