---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { href, signalsDoc, methodology as m, REPO_URL, defang } from "../lib/site";
import { renderDoc } from "../lib/docs";

const signalsMd = renderDoc("SIGNALS.md");
const pct = (x: unknown) => (typeof x === "number" ? `${(x * 100).toFixed(x === 0 || x === 1 ? 0 : 1)}%` : "n/a");
const headline = m
  ? [
      ["FPR on real benign domains (LIKELY+)", pct(m.benign_fpr_likely), `${m.corpus?.benign_real_domains ?? "?"} domains`],
      ["Same, with allowlists disabled", pct(m.benign_fpr_likely_without_allowlists), "intrinsic precision"],
      ["FPR on keyword-bearing hard negatives (LIKELY+)", pct(m.hard_negative_fpr_likely), `${m.corpus?.benign_hard_negatives ?? "?"} names`],
      ["Text analyzer recall at LIKELY+", pct(m.text?.likely?.recall), `precision ${pct(m.text?.likely?.precision)}`],
    ]
  : [];
const patterns = m?.patterns ? Object.entries(m.patterns as Record<string, any>) : [];
const hist = m?.calibration ? (m.calibration as any) : null;
const H = 120;
const maxLure = hist ? Math.max(1, ...Object.values(hist.lure_histogram).map(Number)) : 1;
const maxBenign = hist ? Math.max(1, ...Object.values(hist.benign_histogram).map(Number)) : 1;
const buckets = hist
  ? Object.keys(hist.benign_histogram).map((label) => {
      const lure = Number(hist.lure_histogram[label] ?? 0);
      const benign = Number(hist.benign_histogram[label] ?? 0);
      return { label, lure, benign, lureH: lure ? Math.max(2, Math.round((lure / maxLure) * H)) : 0, benignH: benign ? Math.max(2, Math.round((benign / maxBenign) * H)) : 0 };
    })
  : [];
---
<Base title="Methodology: how LureRadar scores lures" description="Every LureRadar score is a sum of named, weighted signals with evidence. Frozen weights, reproducible benchmark (make bench), false-positive rate on real benign domains and honest blind spots." og="methodology">
  <PageHeader eyebrow="Methodology" title="How a lure" em="gets scored.">
    <p>Scores are the sum of named signals (clamped to 0–100). Keywords alone never score, allowlisted outlets are always CLEAR, and blocklists only contain LIKELY+. No machine-learning model and no LLM in the scoring path.</p>
  </PageHeader>
  <div class="wrap">
    <ol class="scale" aria-label="Tier thresholds" data-reveal>
      <li style="--c:var(--radar)"><span class="r mono">0–39</span><span class="t">Clear</span><span class="muted small">not flagged</span></li>
      <li style="--c:var(--amber)"><span class="r mono">40–69</span><span class="t">Suspicious</span><span class="muted small">on watch, never blocked</span></li>
      <li style="--c:var(--danger)"><span class="r mono">70–89</span><span class="t">Likely</span><span class="muted small">in the blocklists</span></li>
      <li style="--c:var(--danger)"><span class="r mono">90–100</span><span class="t">Confirmed</span><span class="muted small">or corroborated</span></li>
    </ol>

    <h2>Benchmark</h2>
    {m ? (
      <>
        <div class="readout bench" data-reveal>{headline.map(([k, v, s]) => <div><div class="value">{v}</div><div class="label">{k}<br /><span class="muted">{s}</span></div></div>)}</div>
        <p class="muted small">Reproduce: <code>make bench</code> (seed {m.generated_with?.seed ?? "?"}, clock {String(m.generated_with?.now ?? "").slice(0, 10)}). Synthetic lures are written by the same people who wrote the rules, so recall on them is optimistic; read the <a href={href("docs/benchmarks/")}>full report and blind spots</a>.</p>
        {patterns.length > 0 && (
          <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable table">
            <table>
              <thead><tr><th scope="col">Pattern</th><th scope="col">Label</th><th scope="col">n</th><th scope="col">SUSPICIOUS+</th><th scope="col">LIKELY+</th><th scope="col">Example</th></tr></thead>
              <tbody>{patterns.map(([name, p]) => <tr><td class="mono">{name}</td><td>{p.label}</td><td class="mono">{p.n}</td><td class="mono">{pct(p.suspicious_plus)}</td><td class="mono">{pct(p.likely_plus)}</td><td class="mono muted ex">{p.example ? defang(String(p.example)) : ""}</td></tr>)}</tbody>
            </table>
          </div>
        )}
        {hist && (
          <figure class="dist" data-reveal>
            <figcaption class="dist-head">
              <h3>Score distribution, offline, allowlists off</h3>
              <p class="muted small"><span class="key lure"></span> synthetic lures (above the axis) · <span class="key benign"></span> real benign domains (below) · each half on its own scale, counts on every bar</p>
            </figcaption>
            <div class="plot" role="img" aria-label={`Histogram of offline scores. Highest benign score without allowlists: ${hist.max_benign_score_without_allowlists}; margin to the LIKELY threshold: ${hist.likely_threshold_margin} points.`}>
              <div class="half up">{buckets.map((b) => <div class="col"><span class="v">{b.lure || ""}</span><i style={`height:${b.lureH}px`}></i></div>)}</div>
              <div class="axis">{buckets.map((b) => <span>{b.label}</span>)}</div>
              <div class="half down">{buckets.map((b) => <div class="col"><i style={`height:${b.benignH}px`}></i><span class="v">{b.benign || ""}</span></div>)}</div>
              <span class="thr" style="left:40%"><b>40 · suspicious</b></span>
              <span class="thr hot" style="left:70%"><b>70 · blocklisted</b></span>
            </div>
            <p class="muted small">Highest benign score without allowlists: <strong>{hist.max_benign_score_without_allowlists}</strong>. Margin to the LIKELY threshold: <strong>{hist.likely_threshold_margin} points</strong>.</p>
          </figure>
        )}
      </>
    ) : (
      <div class="empty"><strong>No benchmark results in this build</strong>Run <code>make bench</code> to produce <code>bench/results/latest.json</code>; the numbers appear here on the next site build.</div>
    )}

    <h2>Signals</h2>
    {signalsMd ? (
      <div class="prose" set:html={signalsMd.html} />
    ) : signalsDoc.length ? (
      <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable table">
        <table>
          <thead><tr><th scope="col">Signal</th><th scope="col">Weight</th><th scope="col">What it means</th></tr></thead>
          <tbody>{signalsDoc.map((s) => <tr><td><span class="mono">{s.id}</span><br /><span class="muted">{s.title}</span></td><td class="mono">{s.weight}</td><td>{s.description}</td></tr>)}</tbody>
        </table>
      </div>
    ) : (
      <div class="empty"><strong>Signal documentation unavailable</strong>See the repository.</div>
    )}
    <p class="muted">Weights live in <a href={`${REPO_URL}/blob/main/src/lureradar/scoring/weights.py`}>scoring/weights.py</a>; changing one requires re-running the benchmark in the same PR.</p>
  </div>
</Base>
<style>
  .small { font-size: 0.86rem; }
  .scale { list-style: none; margin: 0 0 8px; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .scale li { position: relative; display: grid; gap: 4px; padding: 20px 20px 18px; border-left: 1px solid var(--border); }
  .scale li:first-child { border-left: 0; }
  .scale li::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--c); }
  .scale .r { font-size: 0.78rem; color: var(--muted); }
  .scale .t { font: 700 2rem/0.95 var(--font-display); font-stretch: 66%; text-transform: uppercase; color: var(--c); }
  @media (max-width: 760px) { .scale { grid-template-columns: 1fr 1fr; } .scale li:nth-child(3) { border-left: 0; } .scale li:nth-child(n+3) { border-top: 1px solid var(--border); } }
  .bench .value { font-size: clamp(2rem, 3.6vw, 3rem); }
  .bench .label { color: var(--text-2); font-size: 0.86rem; margin-top: 12px; line-height: 1.5; }
  .ex { font-size: 0.8rem; overflow-wrap: anywhere; max-width: 260px; }
  .key { display: inline-block; width: 10px; height: 10px; border-radius: 2px; vertical-align: 0; margin-right: 4px; }
  .key.benign { background: var(--radar); }
  .key.lure { background: var(--danger); }
  .dist { margin: 40px 0 0; padding: clamp(20px, 3vw, 32px); border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .dist-head h3 { margin: 0 0 6px; }
  .plot { position: relative; margin: 28px 0 18px; }
  .half { display: grid; grid-template-columns: repeat(10, 1fr); gap: 10px; height: 140px; }
  .half.up { align-items: end; }
  .half.down { align-items: start; }
  .col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 6px; height: 100%; }
  .down .col { justify-content: flex-start; }
  .col i { display: block; width: 100%; max-width: 46px; border-radius: 3px 3px 0 0; background: var(--danger); transform-origin: bottom; }
  .down .col i { border-radius: 0 0 3px 3px; background: var(--radar); transform-origin: top; }
  :global(.js) .dist .col i { transform: scaleY(0); transition: transform 1.1s var(--ease-out); }
  :global(.js) .dist.is-in .col i { transform: none; }
  .col .v { font: 400 0.7rem/1 var(--font-mono); color: var(--muted); min-height: 0.7rem; }
  .axis { display: grid; grid-template-columns: repeat(10, 1fr); gap: 10px; border-top: 1px solid var(--border-strong); border-bottom: 1px solid var(--border-strong); padding: 8px 0; margin: 0; }
  .axis span { text-align: center; font: 400 0.68rem/1 var(--font-mono); color: var(--muted); }
  .thr { position: absolute; top: -10px; bottom: -10px; width: 0; border-left: 1px dashed var(--amber); }
  .thr.hot { border-left-color: var(--danger); }
  .thr b { position: absolute; top: -12px; left: 6px; white-space: nowrap; font: 500 0.62rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--amber); }
  .thr.hot b { color: var(--danger); }
  @media (max-width: 640px) { .half, .axis { gap: 4px; } .axis span { font-size: 0.55rem; } .col .v { font-size: 0.55rem; } .thr b { display: none; } }
</style>
