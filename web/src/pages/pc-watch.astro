---
import Base from "../layouts/Base.astro";
import CopyBlock from "../components/CopyBlock.astro";
import PageHeader from "../components/PageHeader.astro";
import { abs, href, pcwatch, packs, fmtUtc, REPO_URL } from "../lib/site";

const status = String(pcwatch.status ?? "UNKNOWN");
const confirmed = String(pcwatch.confirmed_status ?? "UNKNOWN");
const gta = packs.find((p) => p.id === "gta6");
const fact = gta?.facts?.find((f: any) => f.id === "pc_release");
const timeline: any[] = pcwatch.timeline ?? [];
const sources: any[] = pcwatch.sources ?? [];
const tone = status === "NOT_ANNOUNCED" ? "ok" : status === "UNKNOWN" ? "unknown" : "changed";
const faq = [
  {
    q: "Is a GTA 6 PC download real?",
    a: `${fact ? `As of ${fact.as_of}, ${fact.claim.replace(/^As of [0-9-]+ /, "")}` : "No official PC version has been announced."} Any "GTA 6 PC download", "PC beta key" or "PC crack" is therefore not genuine. Paste the link into the LureRadar checker before clicking.`,
  },
  {
    q: "How will I know when PC is announced?",
    a: "Subscribe to the PC Watch Atom feed or poll pc-watch.json. LureRadar checks official sources (Rockstar Newswire, Take-Two press releases and filings, official stores) every few hours. When an official announcement appears, a maintainer verifies it and the status changes here.",
  },
  {
    q: "Why does the status sometimes say UNKNOWN?",
    a: "If the official sources could not be checked successfully in the last 36 hours, LureRadar shows UNKNOWN instead of repeating an old answer. It never shows NOT ANNOUNCED because a check failed.",
  },
];
const jsonld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base title="Is GTA 6 coming to PC? PC Watch" description="Is GTA 6 coming to PC? Dated answer from official sources only (Rockstar, Take-Two, official stores), checked every few hours. GTA 6 PC release date tracker and why any 'GTA 6 PC download' is a lure." og="pc-watch" jsonld={jsonld}>
  <PageHeader eyebrow="PC Watch · official sources only" title="Is GTA 6 coming" em="to PC?">
    <p>A dated answer from official sources only (Rockstar, Take-Two, official stores), checked every few hours. Rumours, leaks and press articles never change the status.</p>
  </PageHeader>
  <div class="wrap">
    <div class={`banner ${tone}`} role="status" data-reveal>
      <div class="banner-main">
        <p class="label-caps">Current status</p>
        <p class="status"><span class="lamp live" aria-hidden="true"></span>{status.replaceAll("_", " ")}</p>
        <p class="answer">{status === "UNKNOWN"
          ? "Status unknown right now: official sources have not been checked successfully in the last 36 hours, so we will not repeat an old answer."
          : (pcwatch.answer ?? "No status available yet.")}</p>
        {pcwatch.note && status !== "UNKNOWN" && <p class="note">{pcwatch.note}</p>}
        {pcwatch.review_pending && <p class="note">Official-source evidence of a change is awaiting maintainer review.</p>}
      </div>
      <dl>
        <div><dt>Last checked</dt><dd class="mono">{fmtUtc(pcwatch.last_checked)}</dd></div>
        <div><dt>Last successful check</dt><dd class="mono">{fmtUtc(pcwatch.last_success)}</dd></div>
        <div><dt>Last status change</dt><dd class="mono">{fmtUtc(pcwatch.last_changed)}</dd></div>
        <div><dt>Maintainer-confirmed</dt><dd class="mono">{confirmed.replaceAll("_", " ")}{pcwatch.confirmed_as_of && ` · as of ${pcwatch.confirmed_as_of}`}</dd></div>
      </dl>
    </div>
    {fact && (
      <p class="fact" data-reveal><span class="label-caps">Fact on record</span> “{fact.claim}” Sources: {fact.sources.map((s: any, i: number) => <>{i ? ", " : ""}<a href={s.url}>{s.publisher ?? s.title}</a></>)}. Wording stays true if things change: we say what is announced <em>as of a date</em>, never what “will never” happen.</p>
    )}

    <h2>Evidence timeline</h2>
    {timeline.length ? (
      <ol class="timeline">
        {timeline.map((e) => (
          <li data-reveal>
            <time class="mono" datetime={e.date}>{e.date}</time>
            <div>
              <p class="t-title"><a href={e.url}>{e.title}</a> <span class="muted">· {e.source}</span></p>
              <p>{e.paraphrase}</p>
              <p class="muted">What it means: {e.meaning}</p>
              <p class="muted small">Verified {e.verified_on}: {e.verification}</p>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <div class="empty"><strong>No timeline entries yet</strong>Entries are added only after they are verified against an official source.</div>
    )}

    <h2>Official sources checked</h2>
    {sources.length ? (
      <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable table">
        <table>
          <thead><tr><th scope="col">Source</th><th scope="col">Kind</th><th scope="col">Last result</th><th scope="col">Detail</th></tr></thead>
          <tbody>{sources.map((s) => <tr><td>{s.name}</td><td class="muted">{s.kind}</td><td class={`mono res-${s.status}`}>{s.status === "unsupported" ? "UNKNOWN" : s.status}</td><td class="muted">{s.detail}</td></tr>)}</tbody>
        </table>
      </div>
    ) : (
      <div class="empty"><strong>No automated check has run yet</strong>The <code>pc-watch</code> workflow checks Rockstar Newswire, Take-Two press releases and SEC filings, and Steam every 4 hours. Until its first successful run the status above stays UNKNOWN.</div>
    )}
    <p class="muted small">Press articles, leaks, rumours and non-official social posts never change the status. Only a maintainer-approved commit to <a href={`${REPO_URL}/blob/main/packs/gta6/facts.yaml`}>facts.yaml</a> does.</p>

    <h2>Get notified</h2>
    <p>Add the Atom feed to any RSS reader, or poll the JSON (no accounts, no email). Webhook example: <a href={`${REPO_URL}/blob/main/examples/pc-watch-webhook.md`}>Discord / Slack</a>.</p>
    <CopyBlock text={abs("feeds/pc-watch.atom")} label="Copy Atom feed URL" />
    <p><a href={href("feeds/pc-watch.json")}>pc-watch.json</a> · <a href={href("feeds/shields-pc-watch.json")}>badge JSON</a></p>

    <h2>FAQ</h2>
    <div class="faqs">{faq.map((f) => <details class="faq"><summary>{f.q}<span class="chev" aria-hidden="true"></span></summary><div class="faq-a"><p>{f.a}</p></div></details>)}</div>
    <p class="disclaimer-note muted">{pcwatch.disclaimer ?? "LureRadar is an independent, unofficial project, not affiliated with Rockstar Games or Take-Two Interactive."}</p>
    <p class="cta-row"><a class="btn primary" href={href("check/")}>Check a “GTA 6 PC” link <span class="arr" aria-hidden="true">→</span></a> <a class="btn" href={href("feeds/")}>Block fake download sites</a></p>
  </div>
</Base>
<style>
  .banner { --tone: var(--muted); display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); padding: clamp(24px, 3.4vw, 40px); border: 1px solid var(--border); border-radius: 20px; background: radial-gradient(ellipse 80% 120% at 0% 0%, color-mix(in srgb, var(--tone) 10%, transparent), transparent 60%), var(--surface); }
  .banner.ok { --tone: var(--radar); }
  .banner.changed { --tone: var(--amber); }
  .banner-main p { margin: 0; }
  .status { display: flex; align-items: center; gap: 20px; margin: 14px 0 18px !important; font: 700 clamp(3.4rem, 8vw, 6.4rem)/0.86 var(--font-display); font-stretch: 64%; text-transform: uppercase; color: var(--tone); }
  .status .lamp { --c: var(--tone); width: 14px; height: 14px; }
  .answer { font-size: 1.12rem; color: var(--text-2); max-width: 44ch; }
  .note { color: var(--amber); margin-top: 12px !important; }
  .banner dl { margin: 0; display: grid; gap: 0; align-content: center; border-top: 1px solid var(--border); }
  .banner dl > div { padding: 13px 0; border-bottom: 1px solid var(--border); }
  dt { color: var(--muted); font: 500 0.66rem/1.4 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; }
  dd { margin: 4px 0 0; font-size: 0.88rem; color: var(--text); }
  @media (max-width: 860px) { .banner { grid-template-columns: minmax(0, 1fr); } }
  .fact { margin-top: 22px; color: var(--muted); max-width: 80ch; }
  .fact .label-caps { margin-right: 10px; }
  .timeline { list-style: none; padding: 0; margin: 0; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 132px; top: 8px; bottom: 8px; width: 1px; background: var(--border-strong); }
  .timeline li { position: relative; display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 32px; padding: 0 0 30px; }
  .timeline li::before { content: ""; position: absolute; left: 128px; top: 7px; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--radar); }
  .timeline time { color: var(--muted); font-size: 0.82rem; padding-top: 2px; }
  .timeline p { margin: 0 0 6px; color: var(--text-2); }
  .t-title { font-weight: 600; color: var(--text) !important; }
  @media (max-width: 640px) {
    .timeline::before { left: 4px; }
    .timeline li { grid-template-columns: minmax(0, 1fr); gap: 4px; padding-left: 26px; }
    .timeline li::before { left: 0; }
  }
  .res-ok { color: var(--radar); }
  .res-failed { color: var(--danger); }
  .res-unsupported { color: var(--muted); }
  .faqs { border-top: 1px solid var(--border); }
  .faq { border-bottom: 1px solid var(--border); }
  .faq summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; cursor: pointer; list-style: none; padding: 22px 0; font: 600 clamp(1.25rem, 1.9vw, 1.55rem)/1.2 var(--font-display); font-stretch: 78%; }
  .faq summary::-webkit-details-marker { display: none; }
  .chev { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .chev::before, .chev::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transition: transform 0.45s var(--ease-out); }
  .chev::after { transform: rotate(90deg); }
  .faq[open] .chev::after { transform: rotate(0deg); }
  .faq-a { color: var(--text-2); max-width: 70ch; padding-bottom: 22px; }
  .faq[open] .faq-a { animation: lr-rise 0.5s var(--ease-out) both; }
  .faq-a p { margin: 0; }
  .disclaimer-note { margin-top: 28px; font-size: 0.85rem; }
  .cta-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
</style>
